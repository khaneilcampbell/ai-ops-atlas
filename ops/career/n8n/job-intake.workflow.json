{
  "name": "Job application intake",
  "nodes": [
    {
      "id": "a1",
      "name": "Job link form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "formTitle": "Analyze a job posting",
        "formDescription": "Paste a job link. The posting is scored against your career database and added to the tracker. Nothing is tailored or submitted from here.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Job URL",
              "requiredField": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a2",
      "name": "Run jobflow analyze",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "parameters": {
        "command": "=cd \"$JOBFLOW_HOME\" && python3 -m jobflow analyze --json '{{ $json[\"Job URL\"].replace(/'/g, \"\") }}'"
      }
    },
    {
      "id": "a3",
      "name": "Parse result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const lines = $input.first().json.stdout.trim().split('\\n');\nreturn [{ json: JSON.parse(lines[lines.length - 1]) }];"
      }
    },
    {
      "id": "a4",
      "name": "Worth tailoring?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.priority }}",
              "rightValue": "skip",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a5",
      "name": "Ready for your review",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s1",
              "name": "next_step",
              "type": "string",
              "value": "={{ $json.company }} \u00b7 {{ $json.position }} scored {{ $json.match_score }}%. Read {{ $json.report }}, then run: python -m jobflow tailor {{ $json.slug }}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "a6",
      "name": "Skip suggested",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "s2",
              "name": "next_step",
              "type": "string",
              "value": "={{ $json.company }} \u00b7 {{ $json.position }} scored {{ $json.match_score }}%, below your threshold. Tracker row added as low priority; no resume generated."
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    }
  ],
  "connections": {
    "Job link form": {
      "main": [
        [
          {
            "node": "Run jobflow analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run jobflow analyze": {
      "main": [
        [
          {
            "node": "Parse result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse result": {
      "main": [
        [
          {
            "node": "Worth tailoring?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Worth tailoring?": {
      "main": [
        [
          {
            "node": "Ready for your review",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Skip suggested",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}