        "jsCode": "// Synthetic classification only. No AI API is called.\nreturn [{json:{text:JSON.stringify({topic:'General inquiry',urgency:'normal',confidence:1,is_spam:false}),sandbox_mock:true}}];"
      },
      "id": "0ba8a91f-f0d6-4d15-b0ac-47c14a5b0463",
      "name": "Classify with Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        112
      ],
      "notes": "Mock output for plumbing tests; not evidence of AI classification quality."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const inq = $('Normalize Inquiry').first().json;\nconst settings = $('Load Client Settings').first().json;\nconst raw = $input.first().json;\nlet ai = null;\ntry { ai = JSON.parse(raw.text); } catch {}\nconst trusted = ai && typeof ai.confidence === 'number' && Number.isFinite(ai.confidence) && ai.confidence >= 0.7 && ai.confidence <= 1;\nconst urgency = trusted && ['urgent','normal','low'].includes(ai.urgency) ? ai.urgency : 'normal';\nconst spam = !!(trusted && ai.is_spam === true);\nconst clean = (v, max) => String(v ?? '').replace(/[\\r\\n\\t]+/g,' ').trim().slice(0,max);\nconst esc = v => String(v ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;');\nconst now = $now.toISO();\nconst ref = 'SANDBOX-' + $execution.id;\nconst rec = {\n inquiry_ref:ref,received_at:now,name:inq.name,email:inq.email,company:inq.company,phone:inq.phone,\n message:inq.message,source:'sandbox',topic:trusted?clean(ai.topic || 'General inquiry',80):'General inquiry',\n urgency,is_spam:spam,status:spam?'spam':trusted?'new':'manual_review',\n ai_status:trusted?'sandbox_mock':'ai_unavailable',\n owner_email:settings.owner_email,\n ack_subject:'We received your inquiry',\n ack_html:'<p>Thank you for contacting '+esc(settings.firm_name)+'. Your message has been received.</p><p>Reference: '+esc(ref)+'</p>',\n alert_subject:'[SANDBOX] Inquiry '+ref,\n alert_html:'<p>From: '+esc(inq.name)+' &lt;'+esc(inq.email)+'&gt;</p><blockquote>'+esc(inq.message)+'</blockquote>',\n sandbox_only:true\n};\nreturn [{json:rec}];"
      },
