{
  "name": "ai-ops-atlas",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "VITE_ATLAS_WEB=1 npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "validate:catalog": "vitest run src/catalog",
    "tauri": "tauri",
    "lint": "eslint .",
    "version:set": "node scripts/set-version.mjs",
    "visual": "playwright test -c visual",
    "visual:update": "BASELINE=1 playwright test -c visual",
    "visual:shots": "SHOTS=1 playwright test -c visual",
    "visual:compare": "node visual/compare.mjs",
    "measure:power": "POWER=1 playwright test -c visual power",
    "measure:perf": "PERF=1 playwright test -c visual perf"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "js-yaml": "^4.1.0",
    "leva": "^0.10.1",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.15.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
