      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "flow-status",
        "authentication": "none",
        "responseMode": "responseNode",
        "options": {}
