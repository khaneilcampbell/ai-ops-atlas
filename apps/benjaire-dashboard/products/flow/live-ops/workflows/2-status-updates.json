          "mappingMode": "defineBelow",
          "value": {
            "status": "={{ $(\"Read Status Form\").item.json.s }}",
            "status_changed_at": "={{ $now.toISO() }}",
            "reminded": true
          }
        }
      }
    },
    {
      "id": "538de84e-b898-4381-9ba6-85055bd5487b",
      "name": "Log Status Event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_events"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "inquiry_ref": "={{ $(\"Read Status Form\").item.json.ref }}",
            "event": "=status_{{ $(\"Read Status Form\").item.json.s }}",
            "detail": "=from {{ $(\"Find Inquiry\").item.json.status }} to {{ $(\"Read Status Form\").item.json.s }}",
            "at": "={{ $now.toISO() }}"
          }
        }
      }
    },
