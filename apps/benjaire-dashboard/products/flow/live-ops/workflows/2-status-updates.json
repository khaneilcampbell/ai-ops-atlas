        360
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_inquiries"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "inquiry_ref",
              "condition": "eq",
              "keyValue": "={{ $json.ref }}"
            },
            {
              "keyName": "action_token",
              "condition": "eq",
              "keyValue": "={{ $json.t }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "alwaysOutputData": true
    },
    {
      "id": "d5275cd3-3dd2-4d9c-bd03-9e2608395816",
      "name": "Link Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        360
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.inquiry_ref ?? \"\" }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $(\"Read Status Form\").item.json.ref }}"
            },
            {
              "leftValue": "={{ $(\"Read Status Form\").item.json.s }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "invalid"
            },
            {
              "leftValue": "={{ $(\"Read Status Form\").item.json.t }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "invalid"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8588c9f5-0385-4fdf-bd74-86fd86c2bae4",
      "name": "Update Status",
