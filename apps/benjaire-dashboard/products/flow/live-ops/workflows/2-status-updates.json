    {
      "id": "4470e69a-cd82-44ee-b9ff-d5aa26d3cf47",
      "name": "Read Status Form",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        360
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "f-ref",
              "name": "ref",
              "value": "={{ /^INQ-[0-9]{6}-[A-F0-9]{6}$/.test(String($json.body?.ref ?? '')) ? $json.body.ref : 'invalid' }}",
              "type": "string"
            },
            {
              "id": "f-t",
              "name": "t",
              "value": "={{ /^[a-f0-9]{48}$/.test(String($json.body?.t ?? '')) ? $json.body.t : 'invalid' }}",
              "type": "string"
            },
            {
              "id": "f-s",
              "name": "s",
              "value": "={{ ['replied', 'won', 'lost'].includes(String($json.body?.s ?? '')) ? $json.body.s : 'invalid' }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "bf9440dd-877e-4566-9100-4e4ee7d49ca7",
      "name": "Find Inquiry",
