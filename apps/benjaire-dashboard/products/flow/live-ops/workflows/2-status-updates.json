    {
      "id": "5cec1966-99b8-4260-9d29-72fa277268ac",
      "name": "Render Confirm Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const q = $json.query || {};\nconst ref = String(q.ref || '');\nconst t = String(q.t || '');\nconst s = String(q.s || '');\nconst labels = { replied: 'Mark as replied', won: 'Mark as won', lost: 'Mark as lost' };\nconst ok = /^INQ-[0-9]{6}-[A-F0-9]{6}$/.test(ref) && /^[a-f0-9]{48}$/.test(t) && Object.prototype.hasOwnProperty.call(labels, s);\nconst body = ok\n  ? '<h1>' + labels[s] + '?</h1><p>Inquiry ' + ref + '</p>' + (s === 'won' ? '<p>The client will receive your welcome and onboarding email.</p>' : '') + '<form method=\"post\" action=\"/webhook/flow-status-confirm\"><input type=\"hidden\" name=\"ref\" value=\"' + ref + '\"><input type=\"hidden\" name=\"t\" value=\"' + t + '\"><input type=\"hidden\" name=\"s\" value=\"' + s + '\"><button type=\"submit\">Confirm</button></form>'\n  : '<h1>This link is not valid</h1><p>Open the latest alert email for this inquiry and try again.</p>';\nreturn { json: { html: body } };"
      }
    },
    {
      "id": "236b466a-caae-4099-a3ce-4cbe5d920759",
      "name": "Show Confirm Page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        440,
        0
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex\"><title>Benjaire Flow</title><style>body{font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Inter,sans-serif;background:#f3f3f1;color:#1f2124;display:grid;place-items:center;min-height:100vh;margin:0;padding:16px}main{background:#fff;border-radius:20px;padding:32px;max-width:440px;width:100%;box-shadow:0 20px 50px -30px rgba(0,0,0,.4)}h1{font-weight:400;font-size:26px;margin:0 0 8px}p{color:#565b62;line-height:1.6}button{background:#1f2124;color:#fff;border:0;border-radius:999px;padding:12px 24px;font-size:15px;cursor:pointer}small{color:#8e939a;font-family:ui-monospace,Menlo,monospace}</style></head><body><main>{{ $json.html }}<p><small>Benjaire Flow</small></p></main></body></html>",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              },
              {
                "name": "Cache-Control",
                "value": "no-store"
              },
              {
                "name": "X-Frame-Options",
                "value": "DENY"
              }
            ]
          }
        }
      }
    },
    {
      "id": "67ac7f5a-2114-47b1-b38c-dc5b469afabc",
