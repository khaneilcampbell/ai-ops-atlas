        "genericAuthType": "httpBearerAuth",
        "jsonBody": "={{ JSON.stringify({ from: $('Load Client Settings').first().json.from_address, to: [$json.to], reply_to: $('Load Client Settings').first().json.reply_to_email, subject: $json.subject, html: $json.html }) }}",
        "method": "POST",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "url": "https://api.resend.com/emails"
      },
      "notes": "Welcome and onboarding email from contact@ through Resend.",
