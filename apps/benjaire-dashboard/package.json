{
  "name": "benjaire-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "check:worker": "wrangler types worker/worker-configuration.d.ts && tsc -p worker --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test worker/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply benjaire-dashboard --local",
    "start": "wrangler dev",
    "ci": "npm run check:worker && npm test && npm run build && npm run check:secrets && npm run check:flow",
    "check:secrets": "node scripts/check-secrets.mjs dist worker src migrations scripts docs products .github",
    "check:flow": "node scripts/check-flow.mjs",
    "flow:pack": "python3 -I products/flow/build/pack.py",
    "test:a11y": "node scripts/a11y.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@preact/preset-vite": "2.10.6",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
