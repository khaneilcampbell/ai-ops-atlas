{
  "name": "Flow · 3 Reply reminders",
  "nodes": [
    {
      "id": "499e1edd-2110-4248-be6b-0eecdd26296d",
      "name": "Weekdays 9am 1pm 5pm",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9,13,17 * * 1-5"
            }
          ]
        }
      }
    },
    {
      "id": "b602bba4-b138-4641-a26c-6c52cb1df6a8",
      "name": "Load Client Settings",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_settings"
        },
        "returnAll": false,
        "limit": 1,
        "orderBy": true,
        "orderByColumn": "id",
        "orderByDirection": "DESC"
      },
      "executeOnce": true
    },
    {
      "id": "4d13b844-4d54-4443-a954-fb6b17e30811",
      "name": "Find Overdue Inquiries",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_inquiries"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "status",
              "condition": "eq",
              "keyValue": "new"
            },
            {
              "keyName": "reminded",
              "condition": "isFalse"
            },
            {
              "keyName": "reply_due_at",
              "condition": "lt",
              "keyValue": "={{ $now.toISO() }}"
            }
          ]
        },
        "returnAll": true
      },
      "executeOnce": true
    },
    {
      "id": "e8d1f51f-b256-4c90-9236-5f3aea347b49",
      "name": "Compose Reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const r = $json;\nconst s = $('Load Client Settings').first().json;\nconst esc = function (v) { return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); };\nconst due = DateTime.fromISO(String(r.reply_due_at));\nconst hours = Math.max(1, Math.round($now.diff(due, 'hours').hours));\nconst base = String(s.n8n_base_url || '').replace(/\\/+$/, '');\nconst link = function (st) { return base + '/webhook/flow-status?ref=' + encodeURIComponent(r.inquiry_ref) + '&t=' + r.action_token + '&s=' + st; };\nconst btn = function (st, label) { return base ? '<a href=\"' + esc(link(st)) + '\" style=\"display:inline-block;padding:8px 14px;margin:0 6px 6px 0;border-radius:999px;background:#1f2124;color:#fff;text-decoration:none\">' + label + '</a>' : ''; };\nconst html = '<p><b>' + esc(r.name) + (r.company ? ', ' + esc(r.company) : '') + '</b> is still waiting for a reply. It is ' + hours + ' hour' + (hours === 1 ? '' : 's') + ' past your reply target.</p>' +\n  '<p>' + esc(r.summary) + '</p>' +\n  '<p>Email: <a href=\"mailto:' + esc(r.email) + '\">' + esc(r.email) + '</a></p>' +\n  (r.suggested_reply ? '<p><b>Suggested reply</b></p><blockquote>' + esc(r.suggested_reply).replace(/\\n/g, '<br>') + '</blockquote>' : '') +\n  '<p>' + btn('replied', 'I replied to them') + btn('won', 'Became a client') + btn('lost', 'Close: no deal') + '</p>' +\n  '<p style=\"color:#666;font-size:13px;line-height:1.6\"><b>I replied to them</b>: stops reminders. Nothing is sent to them.<br><b>Became a client</b>: sends them the welcome and onboarding email.<br><b>Close: no deal</b>: for no reply, went elsewhere, or a test. Nothing is sent to them.</p>' +\n  '<p style=\"color:#666\">Reference ' + esc(r.inquiry_ref) + '. This is the only reminder for this inquiry.</p>';\nreturn { json: { inquiry_ref: r.inquiry_ref, hours_overdue: hours, to: s.owner_email, from: s.from_address, reply_to: r.email, subject: 'Reminder: reply to ' + r.name + ' (' + r.inquiry_ref + ')', html: html } };"
      }
    },
    {
      "id": "6a71a024-cb3d-44c2-9b6c-f5682fdaa38e",
      "name": "Send Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ from: $json.from, to: [$json.to], reply_to: $json.reply_to, subject: $json.subject, html: $json.html }) }}"
      },
      "retryOnFail": true,
      "maxTries": 2,
      "onError": "continueRegularOutput"
    },
    {
      "id": "3be8cb51-fee0-4b8f-a545-dab7f67c4285",
      "name": "Mark Reminded",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_inquiries"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "inquiry_ref",
              "condition": "eq",
              "keyValue": "={{ $('Compose Reminder').item.json.inquiry_ref }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "reminded": true
          }
        }
      }
    },
    {
      "id": "4b7dee13-dd92-4251-a6c8-76fd20788503",
      "name": "Log Reminder Event",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1320,
        300
      ],
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_events"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "inquiry_ref": "={{ $('Compose Reminder').item.json.inquiry_ref }}",
            "event": "reminded",
            "detail": "={{ $(\"Compose Reminder\").item.json.hours_overdue }}h overdue · email {{ $(\"Send Reminder\").item.json.id ? \"sent\" : \"failed\" }}",
            "at": "={{ $now.toISO() }}"
          }
        }
      }
    },
    {
      "id": "862a88e2-3229-402f-b10f-7a9db8e3a957",
      "name": "Sticky Note 3a29ef19",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -20
      ],
      "parameters": {
        "content": "## Flow · Reply reminders\nWeekdays at 9am, 1pm and 5pm in the workflow's time zone (about 65 runs a month). Any inquiry still marked new after its reply target gets one reminder to the owner, from contact@ via Resend, with the status buttons. Each inquiry is reminded once.",
        "color": 7,
        "width": 520,
        "height": 200
      }
    }
  ],
