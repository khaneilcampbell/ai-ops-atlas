    },
    {
      "id": "b1183359-2df4-4302-97c2-2b2d90064c33",
      "name": "Link Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        360
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.inquiry_ref ?? \"\" }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $(\"Read Status Form\").item.json.ref }}"
            },
            {
              "leftValue": "={{ $(\"Read Status Form\").item.json.s }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "invalid"
            },
            {
              "leftValue": "={{ $(\"Read Status Form\").item.json.t }}",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              },
              "rightValue": "invalid"
            },
            {
              "id": "c61556de-2130-4421-8f37-5e59c4e3f72b",
              "leftValue": "={{ $json.token_expires_at ? new Date($json.token_expires_at).getTime() > Date.now() : true }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "8759d61d-4845-42f9-85f4-9046db0257af",
