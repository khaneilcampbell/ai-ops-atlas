      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_inquiries"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "inquiry_ref",
              "condition": "eq",
              "keyValue": "={{ $(\"Read Status Form\").item.json.ref }}"
