        360
      ],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "flow_inquiries"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "inquiry_ref",
              "condition": "eq",
              "keyValue": "={{ $json.ref }}"
            },
            {
              "keyName": "action_token",
              "condition": "eq",
              "keyValue": "={{ $json.t }}"
