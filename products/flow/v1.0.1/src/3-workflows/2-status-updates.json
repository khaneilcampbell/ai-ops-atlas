    {
      "id": "034bae77-ea60-4eb3-b7bd-5d7622009205",
      "name": "Compose Welcome Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const inq = $('Find Inquiry').item.json;\nconst s = $json;\nconst esc = function (v) { return String(v == null ? '' : v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;'); };\nconst HEADER = function () { return s.logo_url ? '<img src=\"' + esc(s.logo_url) + '\" width=\"' + (Number(s.logo_width) || 152) + '\" height=\"' + (Number(s.logo_height) || 24) + '\" alt=\"' + esc(s.firm_name) + '\" style=\"display:block;border:0;outline:none;color:#f3f3f1;font:600 14px/24px Arial,sans-serif;letter-spacing:3px\">' : '<span style=\"font:600 14px/24px Arial,sans-serif;letter-spacing:3px;color:#f3f3f1\">' + esc(String(s.firm_name || '').toUpperCase()) + '</span>'; };\nconst FONT = \"Inter,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif\";\nconst MONO = \"'IBM Plex Mono',Menlo,Consolas,monospace\";\nconst P = function (t) { return '<p style=\"margin:0 0 14px\">' + t + '</p>'; };\nconst button = function (url, label) { return '<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:4px 0 10px\"><tr><td style=\"background:#1f2124;border-radius:999px\"><a href=\"' + esc(url) + '\" style=\"display:inline-block;padding:12px 22px;font:500 14px/1 ' + FONT + ';color:#ffffff;text-decoration:none;border-radius:999px\">' + label + '</a></td></tr></table>'; };\nconst shell = function (inner, footExtra) {\n  return '<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"color-scheme\" content=\"light\"></head><body style=\"margin:0;padding:0;background:#f3f3f1\">' +\n  '<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f3f3f1\"><tr><td align=\"center\" style=\"padding:24px 12px\">' +\n  '<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;background:#ffffff;border:1px solid #dcdddb;border-radius:12px;border-collapse:separate;overflow:hidden\">' +\n  '<tr><td style=\"background:#121315;padding:22px 28px;border-radius:12px 12px 0 0\">' + HEADER() + '</td></tr>' +\n  '<tr><td style=\"padding:28px;font:15px/1.6 ' + FONT + ';color:#1f2124\">' + inner + '</td></tr>' +\n  '<tr><td style=\"background:#f3f3f1;border-top:1px solid #dcdddb;padding:20px 28px;font:12px/1.7 ' + FONT + ';color:#565b62;border-radius:0 0 12px 12px\">' +\n  '<div style=\"font-family:' + MONO + ';font-size:11px;letter-spacing:1.3px;text-transform:uppercase;color:#6f747b\">' + esc(s.firm_name) + (s.brand_address ? ' &middot; ' + esc(s.brand_address) : '') + '</div>' +\n  '<div>' + (s.website_url ? '<a href=\"' + esc(s.website_url) + '\" style=\"color:#565b62\">' + esc(String(s.website_url).replace(/^https?:\\/\\//, '').replace(/\\/$/, '')) + '</a> &middot; ' : '') + esc(s.public_email || s.reply_to_email || '') + '</div>' +\n  (footExtra ? '<div>' + footExtra + '</div>' : '') +\n  '</td></tr></table></td></tr></table></body></html>';\n};\nconst first = String(inq.name || '').trim().split(/\\s+/)[0] || 'there';\nconst docs = String(s.onboarding_docs || '').split(';').map(function (d) { return d.trim(); }).filter(Boolean);\nconst step = function (n, title, body) { return '<tr><td width=\"36\" valign=\"top\" style=\"padding:0 0 14px\"><div style=\"width:24px;height:24px;border:1px solid #dcdddb;border-radius:50%;text-align:center;font:12px/24px ' + MONO + ';color:#565b62\">' + n + '</div></td><td valign=\"top\" style=\"padding:0 0 14px\"><div style=\"font-weight:600;color:#1f2124\">' + title + '</div><div style=\"font-size:14px;color:#565b62\">' + body + '</div></td></tr>'; };\nconst docsBody = docs.length ? 'Please send us: ' + docs.map(esc).join('; ') + '.' : 'Anything that shows how you handle inquiries and onboarding today.';\nlet n = 1;\nconst steps = step(n++, 'Send us a few things', docsBody) +\n  (s.booking_link ? step(n++, 'Book the kickoff call', 'Choose a time to map your process and agree on what we automate first.') : '') +\n  step(n++, 'Review your first workflow', 'We&rsquo;ll send it to you for testing before anything goes live.');\nconst html = shell(\n  P('Hi ' + esc(first) + ',') +\n  P('Welcome to ' + esc(s.firm_name) + '. We&rsquo;re glad to be working with ' + esc(inq.company || 'you') + '. Here&rsquo;s how we&rsquo;ll get started.') +\n  '<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:6px 0 6px\">' + steps + '</table>' +\n  (s.booking_link ? button(s.booking_link, 'Choose a kickoff time') : '') +\n  P('Reply to this email with any questions.') +\n  '<p style=\"margin:0\"><b style=\"font-weight:600\">The ' + esc(s.firm_name) + ' team</b><br><span style=\"font-size:14px;color:#565b62\">' + esc(s.public_email || s.reply_to_email || '') + '</span></p>'\n);\nreturn { json: { to: inq.email, subject: 'Welcome to ' + s.firm_name + ': your next steps', html: html, firm_name: s.firm_name, owner_email: s.owner_email } };\n"
      }
    },
