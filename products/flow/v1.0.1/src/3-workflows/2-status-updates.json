    {
      "id": "b6cc13de-7f04-4ffd-96dc-4317bffedf82",
      "name": "Sticky Note f505ac3e",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -300
      ],
      "parameters": {
        "content": "## Flow · Status updates\nThe owner alert links to GET /webhook/flow-status. That only shows a confirm page, so email link scanners cannot change anything. The Confirm button POSTs to /webhook/flow-status-confirm, which checks the reference and its one time token, updates the status, logs it, and on a first win sends the client the welcome and onboarding email.\n\nLinks stop working after token_ttl_days (30 by default).",
        "color": 7,
        "width": 560,
        "height": 240
      }
    },
    {
      "id": "b1249c4f-4809-4c06-b235-bccc61af0a66",
      "name": "Send Welcome Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "contentType": "json",
