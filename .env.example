# Atlas data foundation (PostgreSQL). Placeholders only: never put a real value in this file.
# On the hosted site these are Cloudflare Pages settings (encrypted secrets / bindings), not files.
# Locally, copy to .dev.vars for `wrangler pages dev`. None of these may start with VITE_: anything
# named VITE_* is built into the public page.

# The site's database connection. In production, bind a Cloudflare Hyperdrive config as ATLAS_DB
# instead (Pages > Settings > Bindings > Hyperdrive); this URL is only the local fallback.
# Use the least-privilege atlas_app role from db/roles.sql, never the owner.
ATLAS_DATABASE_URL=postgres://atlas_app:CHANGE_ME@localhost:5432/atlas

# Agent keys for /api/hooks/data/*: comma-separated "key-id:key" pairs. Each key id must be listed
# in server/data/policy.ts, which says what that key may read and write. Keys need 32+ characters;
# make one with: openssl rand -hex 32
ATLAS_DATA_KEYS=task-writer:REPLACE_WITH_A_64_CHARACTER_RANDOM_KEY

# Only for scripts/db-migrate.mjs, run from your own machine: the database OWNER's connection
# string (can create tables). Never set this on the site.
ATLAS_MIGRATE_DATABASE_URL=postgres://atlas_owner:CHANGE_ME@localhost:5432/atlas
